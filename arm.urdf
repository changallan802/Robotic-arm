<?xml version="1.0"?>
<robot name="color_claw_arm">

  <link name="world"/>

  <link name="support_column">
    <visual>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="1.4"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="1.4"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <mass value="100.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="world_to_support" type="fixed">
    <parent link="world"/>
    <child link="support_column"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="3.0 0.18 0.10"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="3.0 0.18 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="support_to_base" type="fixed">
    <parent link="support_column"/>
    <child link="base_link"/>
    <origin xyz="0 0 1.4" rpy="0 0 0"/>
  </joint>

  <link name="x_carriage_link">
    <visual>
      <geometry>
        <box size="0.20 0.20 0.10"/>
      </geometry>
      <material name="silver">
        <color rgba="0.85 0.85 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.20 0.20 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="x_slider_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="x_carriage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.85" upper="0.85" effort="200" velocity="0.5"/>
    <dynamics damping="50.0" friction="20.0"/>
  </joint>

  <link name="y_carriage_link">
    <visual>
      <geometry>
        <box size="0.12 0.80 0.08"/>
      </geometry>
      <material name="blue">
        <color rgba="0.3 0.5 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.80 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="y_slider_joint" type="prismatic">
    <parent link="x_carriage_link"/>
    <child link="y_carriage_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.55" upper="0.55" effort="200" velocity="0.5"/>
    <dynamics damping="50.0" friction="20.0"/>
  </joint>

  <link name="z_slider_link">
    <visual>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.50"/>
      </geometry>
      <material name="silver2">
        <color rgba="0.92 0.92 0.92 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.50"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="z_slider_joint" type="prismatic">
    <parent link="y_carriage_link"/>
    <child link="z_slider_link"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.8" effort="200" velocity="0.5"/>
    <dynamics damping="60.0" friction="25.0"/>
  </joint>

  <link name="claw_base_link">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.08"/>
      </geometry>
      <material name="black">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="z_to_claw_base" type="fixed">
    <parent link="z_slider_link"/>
    <child link="claw_base_link"/>
    <origin xyz="0 0 -0.50" rpy="0 0 0"/>
  </joint>

  <link name="claw_link_1">
    <visual>
      <origin xyz="0 0 -0.12" rpy="0.4 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.24"/>
      </geometry>
      <material name="claw_black1">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="claw_joint_1" type="fixed">
    <parent link="claw_base_link"/>
    <child link="claw_link_1"/>
    <origin xyz="0.09 0.0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="claw_link_2">
    <visual>
      <origin xyz="0 0 -0.12" rpy="0.4 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.24"/>
      </geometry>
      <material name="claw_black2">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="claw_joint_2" type="fixed">
    <parent link="claw_base_link"/>
    <child link="claw_link_2"/>
    <origin xyz="-0.045 0.078 -0.02" rpy="0 0 2.0944"/>
  </joint>

  <link name="claw_link_3">
    <visual>
      <origin xyz="0 0 -0.12" rpy="0.4 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.24"/>
      </geometry>
      <material name="claw_black3">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="claw_joint_3" type="fixed">
    <parent link="claw_base_link"/>
    <child link="claw_link_3"/>
    <origin xyz="-0.045 -0.078 -0.02" rpy="0 0 -2.0944"/>
  </joint>

  <gazebo reference="support_column">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="base_link">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="x_carriage_link">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="y_carriage_link">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="z_slider_link">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="claw_base_link">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="claw_link_1">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="claw_link_2">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
  <gazebo reference="claw_link_3">
    <turnGravityOff>true</turnGravityOff>
  </gazebo>

</robot>
